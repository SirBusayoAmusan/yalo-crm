{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "functions/**", "**/.*", "**/node_modules/**"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ]
}
